// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  drawings    Drawing[]
}

model Architect {
  id         String     @id @default(cuid())
  firmName   String
  firmAddress String?
  createdAt  DateTime   @default(now())
  drawings   Drawing[]
  template   Template?
  corrections Correction[]
}

model Drawing {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architectId String?
  architect   Architect? @relation(fields: [architectId], references: [id])

  filename    String
  filepath    String
  pageNumber  Int     @default(0)

  // Extracted fields
  drawingNumber  String?
  drawingTitle   String?
  revision       String?
  revisionDate   String?
  status         String?
  location       String? // site / building address extracted from the drawing
  fieldCoordinates String? // JSON — {drawing_number:{x,y}, drawing_title:{x,y}, revision:{x,y}, revision_date:{x,y}, status:{x,y}, location:{x,y}}

  // Confidence scores
  confidenceDrawingNumber  Float?
  confidenceDrawingTitle   Float?
  confidenceRevision       Float?
  confidenceRevisionDate   Float?
  confidenceStatus         Float?

  // Conflict info
  conflictDetected Boolean @default(false)
  conflictDetail   String?

  // Document metadata returned by Gemini
  documentType           String? // drawing | cover_sheet | specification | unknown
  titleBlockLocation     String? // bottom | bottom-right | right | left | unknown
  revisionBlockLocation  String? // top-left | left-of-title-block | integrated | none | unknown

  // Extraction metadata
  extractionModel  String?
  pdfplumberRaw    String? // JSON string — full text element array
  flags            String? // JSON string — array of flag strings
  notes            String?

  // Performance / FinOps
  processingTimeMs  Int?   // total pipeline wall-clock time
  pdfplumberTimeMs  Int?   // pdfplumber extraction time
  totalInputTokens  Int?   // sum of all Gemini input tokens for this drawing
  totalOutputTokens Int?   // sum of all Gemini output tokens
  totalCostUsd      Float? // sum of all Gemini call costs

  // Status workflow
  extractionStatus String @default("pending") // pending | processing | extracted | cover_sheet | reviewed | published

  // Timestamps
  extractedAt   DateTime?
  reviewedAt    DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  corrections   Correction[]
  apiCalls      ApiCall[]
}

model ApiCall {
  id              String   @id @default(cuid())
  drawingId       String
  drawing         Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  model           String
  callType        String   @default("extract") // extract | retry
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  thinkingTokens  Int      @default(0)
  totalTokens     Int      @default(0)
  latencyMs       Int      @default(0)
  costUsd         Float    @default(0)
  success         Boolean  @default(true)
  errorMessage    String?
  retryCount      Int      @default(0)

  createdAt       DateTime @default(now())
}

model Correction {
  id             String   @id @default(cuid())
  drawingId      String
  drawing        Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  architectId    String?
  architect      Architect? @relation(fields: [architectId], references: [id])
  fieldName      String
  originalValue  String?
  correctedValue String?
  pattern        String?  // JSON string: { type: 'prefix', value: 'AD' }
  correctedAt    DateTime @default(now())
}

model Template {
  id                    String    @id @default(cuid())
  architectId           String    @unique
  architect             Architect @relation(fields: [architectId], references: [id], onDelete: Cascade)
  titleBlockLocation    String?   // bottom | bottom-right | right | left | unknown
  revisionBlockLocation String?   // top-left | left-of-title-block | integrated | none | unknown
  revisionColumnOrder   String?   // JSON array e.g. ["rev","date","description","by"]
  revisionReadingDirection String? // top-to-bottom | bottom-to-top
  fieldLabelMap         String?   // JSON object mapping discovered labels to canonical names
  titleBlockPattern     String?   // JSON: {side, bbox:{x0,y0,x1,y1}, confirmedDrawingCount, architectFirmName, drawingNumberFormat}
  fieldPositions        String?   // JSON object mapping fields to {x,y} exact coordinates
  valueReplacements     String?   // JSON object storing correction history { fieldName: { originalValue: correctedValue } }
  learnedRules          String?   // JSON array of structured rules [{ type: 'prefix', field: 'drawingNumber', ... }]
  sampleDrawingId       String?
  lastUpdated           DateTime  @default(now())
}

model SystemRule {
  id          String   @id @default(cuid())
  ruleType    String   @unique // e.g., "STATUS_NORMALISATION"
  content     String   // JSON string storing the exact mapping for this category
  description String?
  lastUpdated DateTime @default(now())
}

